focus_neighbor_bottom = NodePath("../BtnClose")
theme_override_font_sizes/font_size = 15
text = "3. Ascolta un Disco (Gratis) — +20 Morale, -10 Stress, Ispirazione"

[node name="HSeparator2" type="HSeparator" parent="PanelMain/Margin/VBox"]
layout_mode = 2

[node name="BtnClose" type="Button" parent="PanelMain/Margin/VBox"]
