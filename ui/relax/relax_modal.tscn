[node name="HSeparator1" type="HSeparator" parent="PanelMain/Margin/VBox"]
layout_mode = 2

[node name="BtnCoffee" type="Button" parent="PanelMain/Margin/VBox"]
layout_mode = 2
focus_neighbor_bottom = NodePath("../BtnWalk")
theme_override_font_sizes/font_size = 15
text = "1. Bevi un Caffè al Bar (2.00 €) — +15 Energia, +5 Stress"

[node name="BtnWalk" type="Button" parent="PanelMain/Margin/VBox"]
layout_mode = 2
